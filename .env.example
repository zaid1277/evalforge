# Root-level overview of the environment variables used across EvalForge.
# Each app also has its own .env.example (api/.env.example, web/.env.example)
# with the same values scoped to that app -- copy those to .env / .env.local
# rather than relying on this file alone.

# --- Backend (api/.env.example) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evalforge

# Recommended for first-time setup -- no Gemini key, quota, or cost needed.
USE_MOCK_LLM=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

MAX_GENERATION_CASES=50
MAX_EVALUATION_CASES=50
MAX_UPLOAD_SIZE_MB=10
CHUNK_TARGET_WORDS=750
CHUNK_MAX_WORDS=1000
EMBEDDING_MODEL=all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.90
GROUNDING_SIMILARITY_THRESHOLD=0.40
ANSWER_SIMILARITY_THRESHOLD=0.75

CORS_ORIGINS=http://localhost:3000

# --- Frontend (web/.env.example) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
