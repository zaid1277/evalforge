# Copy this file to .env and adjust for local development:
#   cp .env.example .env
# Never commit the real .env file.

ENVIRONMENT=development

# PostgreSQL connection string. Replace `postgres:postgres` with your own
# local PostgreSQL username/password (and `createdb evalforge` first) --
# see the README's Setup section.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evalforge

# --- LLM Provider ---
# Recommended for first-time setup: leave USE_MOCK_LLM=true. Mock mode
# returns deterministic fixture data for generation and evaluation, so
# the full app works immediately with no API key, no quota, and no cost.
# Set to false and fill in GEMINI_API_KEY below to use real Gemini calls.
USE_MOCK_LLM=true

# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Only required when USE_MOCK_LLM=false.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Use a Gemini model available to your Google AI Studio/API account.
GEMINI_MODEL=gemini-3.1-flash-lite

# Batch safety limits for dataset generation and model evaluation.
MAX_GENERATION_CASES=50
MAX_EVALUATION_CASES=50

# Maximum size (MB) for a single source file upload or pasted text body.
MAX_UPLOAD_SIZE_MB=10

# Source chunking: target/maximum words per chunk (see chunking_service.py).
CHUNK_TARGET_WORDS=750
CHUNK_MAX_WORDS=1000

# Semantic duplicate detection (see embedding_service.py / duplicate_service.py).
# Runs locally via sentence-transformers -- no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.90

# Grounding heuristic (see grounding_service.py): cosine similarity between
# a reference answer and its exact linked source evidence, below which a
# case is flagged for manual "review grounding". Advisory only. 0.40 rather
# than a naive 0.30 or 0.50, based on measured MiniLM scores -- see the
# comment in app/config.py.
GROUNDING_SIMILARITY_THRESHOLD=0.40

# Model evaluation (see evaluation_service.py): cosine similarity between a
# target model's response and the case's reference_answer, at or above
# which an answerable case is scored "passed". See the comment in
# app/config.py for real measured examples and its known limitations.
ANSWER_SIMILARITY_THRESHOLD=0.75

# Origins allowed to call this API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000
